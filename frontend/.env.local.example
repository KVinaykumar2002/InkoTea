# Defaults live in ../shared/urls.ts — override here for local dev only.
# Production default: https://inkotea.onrender.com/api
#
# Correct (no extra = sign):
# NEXT_PUBLIC_API_URL=https://inkotea.onrender.com/api
#
# Wrong — causes hostname "=https" errors on Vercel:
# NEXT_PUBLIC_API_URL==https://inkotea.onrender.com/api
#
# If unset on Vercel, shared/urls.ts is used automatically.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
